{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next",
			},
		],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@/common": ["./src/components/@common"],
			"@/landing": ["./src/components/@landing"],
			"@/dashboard": ["./src/components/@dashboard"],
			"@/plans": ["./src/components/@plans"],
			"@/progress": ["./src/components/@progress"],
			"@/workout-log": ["./src/components/@workout-log"],
		},
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts",
	],
	"exclude": ["node_modules"],
}
